# Data files — large raw CSVs tracked via Git LFS (see .gitattributes)
# data/raw/Motor_Vehicle_Collisions_-_Crashes_*.csv  # Now tracked via Git LFS
# data/raw/Police_Precincts_*.csv                     # Now tracked via Git LFS
# Keep smaller files tracked
# data/raw/*.xlsx  # Data dictionaries - tracked
# data/raw/*.geojson  # Boundary files - tracked
# data/raw/FDNY_*.csv  # Small firehouse file - tracked
data/interim/*.csv
data/interim/*.pkl
data/interim/*.parquet

# All processed data (generated by pipeline — run `make data` to regenerate)
data/processed/*.csv
data/processed/*.pkl
data/processed/*.parquet
data/processed/*.geojson
data/processed/*.json
data/processed/cache/
data/processed/.cache_manifest.json
data/processed/.data_manifest.json

# Track small, essential processed data (exceptions to above)
!data/processed/demand_lambda_*.csv
!data/processed/distance_matrix_*.csv
!data/processed/firehouses_*.csv
!data/processed/precincts_manhattan.geojson
!data/processed/demand_model_summary.json
# NOTE: crashes_manhattan.csv (109MB) and .parquet (16MB) remain ignored — too large / regenerable

# Generated intermediates in raw/
data/raw/*.pkl

# Manifests (generated by audit scripts)
data/manifests/*.csv

# Don't ignore .gitkeep files
!.gitkeep

# Results — figures and maps are already tracked; heatmaps are bulk-generated
results/heatmaps/
# NOTE: results/tables/, results/figures/, results/maps/, results/optimization/,
#       results/production_v2/, results/simulation/, results/capacity_comparison/,
#       results/cbd_focused_comparison/, results/distance_comparison/
#       are all TRACKED (important project artifacts)

